#: src/executor.cpp
msgid "wash 内建函数:"
msgstr "wash built-in functions:"

#: src/executor.cpp
msgid "  echo(...)        - 输出到 stdout"
msgstr "  echo(...)        - Output to stdout"

#: src/executor.cpp
msgid "  stderr(...)      - 输出到 stderr"
msgstr "  stderr(...)      - Output to stderr"

#: src/executor.cpp
msgid "  panic(...)       - 输出到 stderr 并退出"
msgstr "  panic(...)       - Output to stderr and exit"

#: src/executor.cpp
msgid "  round(n)         - 四舍五入"
msgstr "  round(n)         - Round to nearest integer"

#: src/executor.cpp
msgid "  ceil(n)          - 向上取整"
msgstr "  ceil(n)          - Round up"

#: src/executor.cpp
msgid "  floor(n)         - 向下取整"
msgstr "  floor(n)         - Round down"

#: src/executor.cpp
msgid "  length(s)        - 字符串长度"
msgstr "  length(s)        - String length"

#: src/executor.cpp
msgid "  upper(s)         - 转大写"
msgstr "  upper(s)         - Convert to uppercase"

#: src/executor.cpp
msgid "  lower(s)         - 转小写"
msgstr "  lower(s)         - Convert to lowercase"

#: src/executor.cpp
msgid "  trim(s)          - 去除首尾空白"
msgstr "  trim(s)          - Trim whitespace"

#: src/executor.cpp
msgid "  substr(s,i,n)    - 子串提取"
msgstr "  substr(s,i,n)    - Extract substring"

#: src/executor.cpp
msgid "  find(s,sub)      - 查找子串位置"
msgstr "  find(s,sub)      - Find substring position"

#: src/executor.cpp
msgid "  split(s,delim)   - 分割字符串"
msgstr "  split(s,delim)   - Split string"

#: src/executor.cpp
msgid "  join(range,d)    - 合并为字符串"
msgstr "  join(range,d)    - Join into string"

#: src/executor.cpp
msgid "  read(prompt?)    - 从 stdin 读取一行"
msgstr "  read(prompt?)    - Read a line from stdin"

