msgid "  argc()           - 脚本参数个数"
msgstr "  argc()           - Script argument count"

#: src/executor.cpp
msgid "  argv(i)          - 获取脚本参数"
msgstr "  argv(i)          - Get script argument"

#: src/executor.cpp
msgid "  return(v)        - 从函数返回值"
msgstr "  return(v)        - Return from function"

#: src/executor.cpp
msgid "  break()          - 跳出循环"
msgstr "  break()          - Break out of loop"

#: src/executor.cpp
msgid "  continue()       - 继续下一次循环"
msgstr "  continue()       - Continue to next iteration"
