# help() detailed help content
msgid "help_echo"
msgstr ""
"echo(...)\n"
"Output arguments to stdout, separated by spaces, with a trailing newline.\n"
"\n"
"Example:\n"
"  echo(\"hello\")         → hello\n"
"  echo(1, 2, 3)         → 1 2 3"

msgid "help_stderr"
msgstr ""
"stderr(...)\n"
"Output arguments to stderr.\n"
"\n"
"Example:\n"
"  stderr(\"error!\")      → (output to stderr)"

msgid "help_panic"
msgstr ""
"panic(...)\n"
"Output to stderr and exit the shell with code 1.\n"
"\n"
"Example:\n"
"  panic(\"fatal error\")"

msgid "help_round"
msgstr ""
"round(number)\n"
"Round to nearest integer, returns int.\n"
"\n"
"Example:\n"
"  round(3.5)            → 4\n"
"  round(3.4)            → 3"

msgid "help_ceil"
msgstr ""
"ceil(number)\n"
"Round up to integer, returns int.\n"
"\n"
"Example:\n"
"  ceil(3.1)             → 4"

msgid "help_floor"
msgstr ""
"floor(number)\n"
"Round down to integer, returns int.\n"
"\n"
"Example:\n"
"  floor(3.9)            → 3"

msgid "help_length"
msgstr ""
"length(string)\n"
"Return the length of a string.\n"
"\n"
"Example:\n"
"  length(\"hello\")       → 5"

msgid "help_upper"
msgstr ""
"upper(string)\n"
"Convert to uppercase.\n"
"\n"
"Example:\n"
"  upper(\"hello\")        → HELLO"

msgid "help_lower"
msgstr ""
"lower(string)\n"
"Convert to lowercase.\n"
"\n"
"Example:\n"
"  lower(\"HELLO\")        → hello"

msgid "help_trim"
msgstr ""
"trim(string)\n"
"Remove leading and trailing whitespace.\n"
"\n"
"Example:\n"
"  trim(\"  hi  \")        → hi"

msgid "help_substr"
msgstr ""
"substr(string, start, length)\n"
"Extract a substring. start is 0-based.\n"
"\n"
"Example:\n"
"  substr(\"hello\", 1, 3) → ell"

msgid "help_find"
msgstr ""
"find(string, substring)\n"
"Find substring position, returns -1 if not found.\n"
"\n"
"Example:\n"
"  find(\"hello\", \"ll\")   → 2"

msgid "help_split"
msgstr ""
"split(string, delimiter)\n"
"Split a string by delimiter into a range.\n"
"\n"
"Example:\n"
"  split(\"a,b,c\", \",\")    → [\"a\",\"b\",\"c\"]"

msgid "help_join"
msgstr ""
"join(range, delimiter)\n"
"Join a range into a string with delimiter.\n"
"\n"
"Example:\n"
"  join([\"a\",\"b\"], \"-\")  → a-b"

msgid "help_read"
msgstr ""
"read(prompt?)\n"
"Read a line from stdin.\n"
"\n"
"Example:\n"
"  %name=read(\"Name: \")"

msgid "help_source"
msgstr ""
"source(file)\n"
"Load and execute a .wash file.\n"
"\n"
"Example:\n"
"  source(\"config.wash\")"

msgid "help_unset"
msgstr ""
"unset(variable)\n"
"Delete a variable.\n"
"\n"
"Example:\n"
"  %a=1\n"
"  unset(%a)"

msgid "help_export"
msgstr ""
"export(variable)\n"
"Export a wash variable as an environment variable.\n"
"\n"
"Example:\n"
"  %env.PATH=\"/usr/bin\"\n"
"  export(%env.PATH)"

msgid "help_typeof"
msgstr ""
"typeof(value)\n"
"Return the type name: \"string\", \"int\", or \"double\".\n"
"\n"
"Example:\n"
"  typeof(\"hi\")          → string\n"
"  typeof(42)            → int\n"
"  typeof(3.14)          → double"

msgid "help_help"
msgstr ""
"help()\n"
"Show all built-in commands.\n"
"\n"
"help(\"cmd\")\n"
"Show detailed help for a specific command.\n"
"\n"
"Example:\n"
"  help(\"echo\")"

msgid "help_argc"
msgstr ""
"argc()\n"
"Return the number of script arguments (excluding the script name).\n"
"\n"
"Example:\n"
"  # wash script.wash a b c\n"
"  argc()                → 3"

msgid "help_argv"
msgstr ""
"argv(number)\n"
"Get a script argument. Index starts at 0: argv(0) is the script name.\n"
"Returns empty string if out of bounds.\n"
"\n"
"Example:\n"
"  # wash script.wash hello\n"
"  argv(1)               → hello"

msgid "help_return"
msgstr ""
"return(value)\n"
"Return a value from a function.\n"
"\n"
"Example:\n"
"  add(a, b):{\n"
"    return(calc(%a + %b))\n"
"  }"

msgid "help_break"
msgstr ""
"break()\n"
"Break out of the current for/while loop."

msgid "help_continue"
msgstr ""
"continue()\n"
"Skip the current loop iteration and continue."

msgid "help_fg"
msgstr ""
"fg(color)\n"
"Set foreground color.\n"
"\n"
"Parameter formats:\n"
"  Color name: \"red\", \"green\", \"blue\", \"bright_red\", etc.\n"
"  256-color index: 0-255 (number)\n"
"  True color: \"255,128,0\"\n"
"  Reset: \"reset\"\n"
"\n"
"Example:\n"
"  fg(\"red\")\n"
"  fg(196)\n"
"  fg(\"255,128,0\")\n"
"  fg(\"reset\")"

msgid "help_bg"
msgstr ""
"bg(color)\n"
"Set background color. Same parameter format as fg().\n"
"\n"
"Example:\n"
"  bg(\"blue\")\n"
"  bg(\"reset\")"

msgid "help_colors"
msgstr ""
"colors()\n"
"Display terminal color capabilities, including depth and samples."

