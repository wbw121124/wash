# help() 详细帮助内容
msgid "help_echo"
msgstr ""
"echo(...)\n"
"输出参数到 stdout，参数间以空格分隔，末尾换行。\n"
"\n"
"示例:\n"
"  echo(\"hello\")         -> hello\n"
"  echo(1, 2, 3)         -> 1 2 3"

msgid "help_stderr"
msgstr ""
"stderr(...)\n"
"输出参数到 stderr。\n"
"\n"
"示例:\n"
"  stderr(\"error!\")      -> (输出到 stderr)"

msgid "help_panic"
msgstr ""
"panic(...)\n"
"输出到 stderr 并以退出码 1 终止 shell。\n"
"\n"
"示例:\n"
"  panic(\"fatal error\")"

msgid "help_round"
msgstr ""
"round(number)\n"
"四舍五入取整，返回 int。\n"
"\n"
"示例:\n"
"  round(3.5)            -> 4\n"
"  round(3.4)            -> 3"

msgid "help_ceil"
msgstr ""
"ceil(number)\n"
"向上取整，返回 int。\n"
"\n"
"示例:\n"
"  ceil(3.1)             -> 4"

msgid "help_floor"
msgstr ""
"floor(number)\n"
"向下取整，返回 int。\n"
"\n"
"示例:\n"
"  floor(3.9)            -> 3"

msgid "help_length"
msgstr ""
"length(string)\n"
"返回字符串长度。\n"
"\n"
"示例:\n"
"  length(\"hello\")       -> 5"

msgid "help_upper"
msgstr ""
"upper(string)\n"
"转大写。\n"
"\n"
"示例:\n"
"  upper(\"hello\")        -> HELLO"

msgid "help_lower"
msgstr ""
"lower(string)\n"
"转小写。\n"
"\n"
"示例:\n"
"  lower(\"HELLO\")        -> hello"

msgid "help_trim"
msgstr ""
"trim(string)\n"
"去除首尾空白字符。\n"
"\n"
"示例:\n"
"  trim(\"  hi  \")        -> hi"

msgid "help_substr"
msgstr ""
"substr(string, start, length)\n"
"子串提取。start 从 0 开始。\n"
"\n"
"示例:\n"
"  substr(\"hello\", 1, 3) -> ell"

msgid "help_find"
msgstr ""
"find(string, substring)\n"
"查找子串位置，未找到返回 -1。\n"
"\n"
"示例:\n"
"  find(\"hello\", \"ll\")   -> 2"

msgid "help_split"
msgstr ""
"split(string, delimiter)\n"
"按分隔符分割为 range。\n"
"\n"
"示例:\n"
"  split(\"a,b,c\", \",\")    -> [\"a\",\"b\",\"c\"]"

msgid "help_join"
msgstr ""
"join(range, delimiter)\n"
"按分隔符合并为字符串。\n"
"\n"
"示例:\n"
"  join([\"a\",\"b\"], \"-\")  -> a-b"

msgid "help_read"
msgstr ""
"read(prompt?)\n"
"从 stdin 读取一行输入。\n"
"\n"
"示例:\n"
"  %name=read(\"姓名: \")"

msgid "help_source"
msgstr ""
"source(file)\n"
"加载并执行 .wash 文件。\n"
"\n"
"示例:\n"
"  source(\"config.wash\")"

msgid "help_unset"
msgstr ""
"unset(variable)\n"
"删除变量。\n"
"\n"
"示例:\n"
"  %a=1\n"
"  unset(%a)"

msgid "help_export"
msgstr ""
"export(variable)\n"
"将 wash 变量导出为环境变量。\n"
"\n"
"示例:\n"
"  %env.PATH=\"/usr/bin\"\n"
"  export(%env.PATH)"

msgid "help_typeof"
msgstr ""
"typeof(value)\n"
"返回类型名: \"string\"、\"int\" 或 \"double\"。\n"
"\n"
"示例:\n"
"  typeof(\"hi\")          -> string\n"
"  typeof(42)            -> int\n"
"  typeof(3.14)          -> double"

msgid "help_help"
msgstr ""
"help()\n"
"显示所有内建命令列表。\n"
"\n"
"help(\"cmd\")\n"
"显示指定命令的详细帮助。\n"
"\n"
"示例:\n"
"  help(\"echo\")"

msgid "help_argc"
msgstr ""
"argc()\n"
"返回脚本命令行参数个数（不包括脚本名）。\n"
"\n"
"示例:\n"
"  # wash script.wash a b c\n"
"  argc()                -> 3"

msgid "help_argv"
msgstr ""
"argv(number)\n"
"获取脚本参数。索引从 0 开始：argv(0) 为脚本名。\n"
"越界返回空字符串。\n"
"\n"
"示例:\n"
"  # wash script.wash hello\n"
"  argv(1)               -> hello"

msgid "help_return"
msgstr ""
"return(value)\n"
"从函数返回值。\n"
"\n"
"示例:\n"
"  add(a, b):{\n"
"    return(calc(%a + %b))\n"
"  }"

msgid "help_break"
msgstr ""
"break()\n"
"跳出当前 for/while 循环。"

msgid "help_continue"
msgstr ""
"continue()\n"
"跳过当前循环迭代，继续下一次。"

msgid "help_fg"
msgstr ""
"fg(color)\n"
"设置前景色。\n"
"\n"
"参数格式:\n"
"  颜色名称: \"red\", \"green\", \"blue\", \"bright_red\" 等\n"
"  256色索引: 0-255 (数字)\n"
"  真彩色:    \"255,128,0\"\n"
"  重置:      \"reset\"\n"
"\n"
"示例:\n"
"  fg(\"red\")\n"
"  fg(196)\n"
"  fg(\"255,128,0\")\n"
"  fg(\"reset\")"

msgid "help_bg"
msgstr ""
"bg(color)\n"
"设置背景色。参数格式同 fg()。\n"
"\n"
"示例:\n"
"  bg(\"blue\")\n"
"  bg(\"reset\")"

msgid "help_colors"
msgstr ""
"colors()\n"
"显示终端颜色能力，包括颜色深度和颜色示例。"

