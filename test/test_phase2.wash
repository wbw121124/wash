# Phase 2 功能综合测试
# 测试管道、范围步长、字符串插值、相邻字符串、内建函数等

# 1. 管道表达式
echo("pipe test") | %pipe_out
calc(%pipe_out == "pipe test")

# 2. 范围步长
%sum = 0
for(%i in 1..10..2) { %sum = calc(%sum + %i) }
calc(%sum == 25)

# 3. 字符串变量插值
%name = "wash"
%greeting = "Hello %{name}!"
calc(%greeting == "Hello wash!")

# 4. 相邻字符串自动连接
%full = "hello " "world"
calc(%full == "hello world")

# 5. 复合测试
%data = ""
for(%i in 1..5) { %data = calc(%data + %i) }
calc(%data == "12345")

# 6. 逗号分隔范围
%result = ""
for(%i in "1..3,7..9") { %result = calc(%result + %i) }
calc(%result == "123789")

# 7. 函数定义
fadd = (a, b):{ calc(a + b) }
calc(fadd(3, 4) == 7)

# 8. Lambda
double_it = (x):{ calc(x * 2) }
calc(double_it(5) == 10)

# 9. 内建函数
calc(length("hello") == 5)
calc(upper("hello") == "HELLO")
calc(lower("HELLO") == "hello")
calc(trim("  hello  ") == "hello")
calc(substr("hello", 1, 3) == "ell")

# 10. 字符串比较
calc("abc" == "abc")
calc("abc" != "def")
calc("abc" < "abd")
calc("b" > "a")

# 11. 循环嵌套
%total = 0
for(%i in 1..3) {
    for(%j in 1..3) {
        %total = calc(%total + %i * %j)
    }
}
calc(%total == 36)

# 12. 三元表达式
%val = 10
%result = calc(%val > 5) ? "big" : "small"
calc(%result == "big")

# 13. true/false
calc(true == true)
calc(false == false)
calc(true != false)

# 14. 负数
%neg = -5
calc(%neg == -5)
calc(-3 + 5 == 2)

# 15. 环境变量读写
%env.test_var = "hello"
%a = %env.test_var
calc(%a == "hello")

# 16. 嵌套函数调用
calc(length(upper("hello")) == 5)

# 17. 字符串拼接
calc("hello" + " " + "world" == "hello world")

# 18. 条件逻辑
if(calc(1 == 1)) { echo("条件为真") }

# 19. 循环控制
%count = 0
for(%i in 1..10) {
    if(calc(%i == 5)) { break }
    %count = calc(%count + 1)
}
calc(%count == 4)

# 20. typeof
calc(typeof(42) == "int")
calc(typeof("hello") == "string")

echo("=== All Phase 2 tests passed! ===")
